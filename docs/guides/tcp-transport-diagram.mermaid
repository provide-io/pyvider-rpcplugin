sequenceDiagram
    participant Client
    participant TCPTransport
    participant AsyncioServer
    participant RemoteEndpoint
    
    %% Listen flow
    Client->>+TCPTransport: listen()
    TCPTransport->>+AsyncioServer: asyncio.start_server()
    AsyncioServer-->>-TCPTransport: server
    TCPTransport->>TCPTransport: Extract socket info
    TCPTransport-->>-Client: endpoint (host:port)
    
    %% Connection handling
    RemoteEndpoint->>AsyncioServer: Connect
    AsyncioServer->>+TCPTransport: _handle_client(reader, writer)
    
    loop Data exchange
        RemoteEndpoint->>TCPTransport: Send data
        TCPTransport->>TCPTransport: Process data
        TCPTransport->>RemoteEndpoint: Send response
    end
    
    RemoteEndpoint->>TCPTransport: Disconnect
    TCPTransport-->>-AsyncioServer: End handler
    
    %% Connect flow
    Client->>+TCPTransport: connect(endpoint)
    TCPTransport->>TCPTransport: Parse endpoint
    TCPTransport->>+AsyncioServer: asyncio.open_connection()
    AsyncioServer-->>-TCPTransport: reader, writer
    TCPTransport-->>-Client: Success
    
    %% Close flow
    Client->>+TCPTransport: close()
    TCPTransport->>+AsyncioServer: server.close()
    AsyncioServer-->>-TCPTransport: Closed
    
    alt Writer exists
        TCPTransport->>TCPTransport: Close writer
    end
    
    TCPTransport-->>-Client: Closed
