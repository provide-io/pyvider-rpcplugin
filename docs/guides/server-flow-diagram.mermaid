sequenceDiagram
    participant Terraform
    participant Server as RPCPluginServer
    participant Transport as TransportLayer
    participant Protocol as ProtocolLayer
    participant Handler as PluginHandler
    
    %% Startup
    Terraform->>+Server: Launch process
    Server->>Server: Parse args & initialize
    
    %% Handshake
    Server->>Server: _negotiate_handshake()
    Server->>Transport: negotiate_transport()
    Transport-->>Server: transport_name, transport
    
    %% Server setup
    Server->>Server: _setup_server()
    Server->>Protocol: register_protocol_service()
    Server->>+Transport: listen()
    Transport-->>-Server: endpoint
    
    %% Handshake response
    Server->>Server: build_handshake_response()
    Server-->>Terraform: Handshake response
    
    %% Serving
    Server->>Server: Set _serving_event
    
    %% Connection handling
    loop For each client connection
        Terraform->>Transport: Connect
        Transport->>Protocol: Forward request
        Protocol->>Handler: Process request
        Handler-->>Protocol: Response
        Protocol-->>Transport: Send response
        Transport-->>Terraform: Response
    end
    
    %% Shutdown
    Terraform->>Server: Shutdown signal
    Server->>Server: _shutdown_requested()
    Server->>Server: stop()
    Server->>Transport: close()
    Server->>Protocol: server.stop()
    Server-->>Terraform: Process exits
