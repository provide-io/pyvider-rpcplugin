flowchart TD
    Terraform["Terraform Core"]
    GoPlugin["Go Plugin Bridge"]
    
    subgraph "Pyvider RPC Plugin"
        Server["RPCPluginServer"]
        Client["RPCPluginClient"]
        
        subgraph "Transport Layer"
            TCP["TCPSocketTransport"]
            Unix["UnixSocketTransport"]
            BaseTransport["RPCPluginTransport"]
        end
        
        subgraph "Protocol Layer"
            GrpcProto["gRPC Protocol Implementation"]
            Broker["GRPCBroker Service"]
            Controller["GRPCController Service"]
            Stdio["GRPCStdio Service"]
        end
        
        subgraph "Security Layer"
            Handshake["Handshake Process"]
            Certificate["Certificate Management"]
            MagicCookie["Magic Cookie Validation"]
        end
        
        subgraph "Core Services"
            Config["Configuration System"]
            Logger["Structured Emoji Logger"]
            Exceptions["Exception Hierarchy"]
        end
    end

    ProviderImpl["Provider Implementation"]
    
    Terraform <-->|"TF Protocol"| GoPlugin
    GoPlugin <-->|"Handshake & RPC"| Server
    
    Client <--> Server
    
    Server --> BaseTransport
    Client --> BaseTransport
    
    BaseTransport --> TCP
    BaseTransport --> Unix
    
    Server --> GrpcProto
    Client --> GrpcProto
    
    GrpcProto --> Broker
    GrpcProto --> Controller
    GrpcProto --> Stdio
    
    Server --> Handshake
    Client --> Handshake
    
    Handshake --> MagicCookie
    Handshake --> Certificate
    
    Server --> Config
    Client --> Config
    
    Server -.-> Logger
    Client -.-> Logger
    
    Server -.-> Exceptions
    Client -.-> Exceptions
    
    ProviderImpl --> Client
