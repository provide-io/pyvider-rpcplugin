classDiagram
    class Type {
        <<abstract>>
        +validate(value: Any) T
        +equal(other: Type) bool
        +usable_as(other: Type) bool
    }

    class Value {
        -_raw_value: Any
        -_type: Type
        +type: Type
        +raw_value: Any
        +is_known() bool
        +is_null() bool
        +as_string() str
        +as_number() float
        +as_bool() bool
        +as_value_slice() List[Value]
        +as_value_map() Dict[str, Value]
        +get_attr(name: str) Value
    }

    class UnknownValue {
        -refinements: List[Callable]
        +apply_refinements(value: Any) bool
    }

    class Path {
        -steps: List[PathStep]
        +get_attr(name: str) Path
        +index(key: Any) Path
        +apply(value: Value) Value
    }

    class PathStep {
        <<abstract>>
        +apply(value: Value) Value
    }

    class GetAttrStep {
        -name: str
        +apply(value: Value) Value
    }

    class IndexStep {
        -key: Any
        +apply(value: Value) Value
    }

    %% Primitive Types
    class CtyString {
        +validate(value: Any) str
        +equal(other: Type) bool
        +usable_as(other: Type) bool
    }

    class CtyNumber {
        +validate(value: Any) float
        +equal(other: Type) bool
        +usable_as(other: Type) bool
    }

    class CtyBool {
        +validate(value: Any) bool
        +equal(other: Type) bool
        +usable_as(other: Type) bool
    }

    %% Collection Types
    class CtyList {
        -element_type: Type
        +validate(value: Any) List
        +equal(other: Type) bool
        +usable_as(other: Type) bool
    }

    class CtyMap {
        -key_type: Type
        -element_type: Type
        +validate(value: Any) Dict
        +equal(other: Type) bool
        +usable_as(other: Type) bool
    }

    class CtySet {
        -element_type: Type
        +validate(value: Any) Set
        +equal(other: Type) bool
        +usable_as(other: Type) bool
    }

    %% Structural Types
    class CtyObject {
        -attribute_types: Dict[str, Type]
        -optional_attributes: Set[str]
        +validate(value: Any) Dict
        +get_attribute_type(name: str) Type
        +equal(other: Type) bool
        +usable_as(other: Type) bool
    }

    class CtyTuple {
        -element_types: List[Type]
        +validate(value: Any) Tuple
        +equal(other: Type) bool
        +usable_as(other: Type) bool
    }

    class CtyDynamic {
        +validate(value: Any) Any
        +equal(other: Type) bool
        +usable_as(other: Type) bool
    }

    %% Serialization
    class JSONEncoder {
        <<static>>
        +encode(value: Value) bytes
        -_to_python(value: Value) Any
    }

    class JSONDecoder {
        <<static>>
        +decode(data: bytes, type_def: Type) Value
    }

    class DynamicValueHandler {
        <<static>>
        +encode(value: Value) DynamicValue
        +decode(dynamic_value: DynamicValue, expected_type: Type) Value
    }

    %% Schema Integration
    class FieldDescriptor {
        -_field_metadata: Dict
        -_name: str
        +__get__(obj, objtype) Any
        +__set__(obj, value) None
        +__set_name__(owner, name) None
    }

    %% Relationships
    Type <|-- CtyString
    Type <|-- CtyNumber
    Type <|-- CtyBool
    Type <|-- CtyList
    Type <|-- CtyMap
    Type <|-- CtySet
    Type <|-- CtyObject
    Type <|-- CtyTuple
    Type <|-- CtyDynamic

    PathStep <|-- GetAttrStep
    PathStep <|-- IndexStep
    Path o-- PathStep

    Value --> Type
    Value ..> UnknownValue : uses
    Value ..> Path : uses

    JSONEncoder ..> Value : uses
    JSONDecoder ..> Value : uses
    JSONDecoder ..> Type : uses

    DynamicValueHandler ..> Value : uses
    DynamicValueHandler ..> Type : uses
    DynamicValueHandler ..> JSONEncoder : uses
    DynamicValueHandler ..> JSONDecoder : uses

    CtyList --> Type : element_type
    CtyMap --> Type : element_type
    CtyMap --> Type : key_type
    CtySet --> Type : element_type
    CtyObject --> Type : attribute_types
    CtyTuple --> Type : element_types
